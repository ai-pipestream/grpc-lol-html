# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/


# Added by cargo

/target

# --- Demo build artifacts (generated; never committed) ---
# Node: installed deps. package-lock.json IS committed for reproducibility.
demos/node-client/node_modules/
# Python: virtualenv, protoc-generated stubs, and bytecode caches. The fixture
# generator under demos/sample-data leaves one behind when it is imported.
demos/python-client/.venv/
demos/python-client/gen/
__pycache__/
# Java: Maven output (includes protoc-generated sources).
demos/java-client/target/

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/

# --- Local logs and scratch ---
*.log
